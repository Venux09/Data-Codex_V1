#basically given the ingridient the person have it will recommend a recipe according to data 
spice_list = ['salt', 'pepper', 'oregano', 'sage', 'parsley',
 'rosemary', 'tarragon', 'thyme', 'paprika', 'cumin']


%xmode Verbose
import re
#findinng the boolean indexing if the dataframe has these certain spices in the list or not 
spice_df = pd.DataFrame({
    spice : recipes.ingredients.str.contains(spice,re.IGNORECASE
                                             ) for spice in spice_list})


spice_df


#selecting ingredients with parslye parpika and sage


selection = spice_df.query('parsley&paprika&tarragon')


len(selection)


